    "Potentials": {
        "1": {
            "Name": "Foga selvaggia",
            "Desc": "All'inizio della battaglia, Kay ottiene 1 accumulo di <@ba.key>Monelli da lancio ardenti</>.\nTalento <@ba.key>Arsenale infinito</> migliorato: ogni recupero di <@ba.key>armi</> conferisce all'intera squadra <@ba.vup>+2.0%</> di <#ba.spelldmg>danni da Arti inflitti</> e un ulteriore <@ba.vup>+2.0%</> di <@ba.natur>danni da natura inflitti</> con una durata prolungata di <@ba.vup>+10</> s."
        },
        "2": {
            "Name": "Esperta vagabonda",
