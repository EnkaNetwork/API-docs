    "Potentials": {
        "1": {
            "Name": "Пробуждение дикого нрава",
            "Desc": "Вступая в бой, Кей получает 1 заряд эффекта <@ba.key>Наивная острота</>.\nУлучшает талант <@ba.key>Бездонный арсенал</>: каждое подобранное <@ba.key>оружие</> дает всей команде дополнительно <@ba.vup>+2.0%</> к <#ba.spelldmg>наносимому УРН от искусств</> и еще <@ba.vup>+2.0%</> к <@ba.natur>наносимому природному УРН</>, а длительность эффекта увеличивается еще на <@ba.vup>10</> сек."
        },
        "2": {
            "Name": "Опытный следопыт",
            "Desc": "Сила <@ba.vup>+20</>, <@ba.natur>наносимый природный УРН</> <@ba.vup>+10%</>."
        },
        "3": {
            "Name": "Подготовка к пикнику",
            "Desc": "Улучшает боевой навык <@ba.key>Очень тяжелый удар</>: множитель бонусного УРН за каждый заряд эффекта <@ba.key>Наивная острота</> повышается до <@ba.vup>1.2</> р. от первоначального. Улучшает супернавык <@ba.key>Очень славная комбостукалка!</>: множитель УРН повышается до <@ba.vup>1.2</> р. от первоначального."
        },
        "4": {
            "Name": "«Самодельная колотушка»",
